{
  "name": "harness-manager",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Panoramic agent-harness dashboard: hosted web UI + headless local agent for visualizing and managing any agent harness over an E2E-encrypted relay",
  "license": "MIT",
  "scripts": {
    "pull": "bun scripts/pull.ts",
    "build:online": "vite build",
    "agent": "bun agent.ts",
    "engine": "bun server.ts",
    "dev": "vite",
    "relay:dev": "bun relay/dev.ts",
    "test": "bun test",
    "types:check": "tsc --noEmit",
    "types:relay": "tsc -p relay/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check \"**/*.{json,yml,yaml,css,html}\" --ignore-path .prettierignore",
    "format:fix": "prettier --write \"**/*.{json,yml,yaml,css,html}\" --ignore-path .prettierignore",
    "urls:bake": "bun scripts/bake-urls.ts",
    "repo:check": "bun run format:check && bun run lint && bun run types:check && bun run types:relay && bun test",
    "deploy:ui": "bun run build:online && wrangler deploy"
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "cytoscape-fcose": "^2.2.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.1",
    "ajv": "^8.20.0",
    "eslint": "^9.28.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.149.0"
  }
}
